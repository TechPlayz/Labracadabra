# Supply all Supabase settings for institutional mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Kept on the server. Choose a Gemini model supported by your project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set DEMO_MODE=true to use the isolated demo store.
# Set true in .env.local to use the demo with both npm run dev and npm run start.
# An unset flag preserves the local development default. Set false for institutional hosting.
DEMO_MODE=
# Set a writable path on persistent storage for deployed demo data.
# Defaults to .labracadabra-demo/workspace.json locally and a temporary file on Vercel.
LABRACADABRA_DEMO_FILE=
